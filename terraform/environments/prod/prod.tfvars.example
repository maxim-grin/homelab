# Copy to prod.tfvars and fill in. prod.tfvars is gitignored (*.tfvars) and
# has no backup anywhere. It carries the Proxmox API token.
#
# Prerequisites, none of which Terraform creates (docs/rebuild.md):
#   - the Talos-K8s resource pool, with TerraformProv granted on it
#   - the talos-tp template, built from the Image Factory nocloud image

pm_target_node      = "pve"
pm_api_url          = "https://<PROXMOX_IP>:8006/api2/json"
pm_api_token_id     = "root@pam!terraform"
pm_api_token_secret = "<UUID>"

# The LAN's gateway. Node addresses sit outside the router's DHCP pool.
gateway = "192.0.2.1"

# cp1 is 4096, not Talos's documented minimum of 2048: at 2048 the API server
# became unresponsive (connection refused, TLS handshake timeouts, the VM's
# memory at its ceiling) when ArgoCD re-applied the monitoring chart, with its
# large CRDs, after a merge on 2026-10-06.
#
# Workers are 7168, not 4096: dev's 6 GB was moved here when dev was paused
# (ADR 0034). The defaults in variables.tf (4 cores, 40G disk) also grew.
talos_nodes = {
  cp1 = { role = "controlplane", vmid = 3101, ip = "192.0.2.110", memory = 4096 }
  w1  = { role = "worker", vmid = 3201, ip = "192.0.2.111", memory = 7168 }
  w2  = { role = "worker", vmid = 3202, ip = "192.0.2.112", memory = 7168 }
}
