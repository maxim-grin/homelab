# Example shape of ansible/secret.yaml. The real file is encrypted with
# ansible-vault and IS committed -- only its password lives outside git.
#
#   ansible-vault create secret.yaml     # first time
#   ansible-vault edit secret.yaml       # afterwards
#   ansible-vault view secret.yaml
#
# Every playbook is run with `-e @secret.yaml --ask-vault-pass`, so these
# arrive as extra-vars and therefore outrank anything in group_vars.
#
# Losing the vault password loses this file: it holds the addresses and ids
# of every host, and nothing else in the repository records them. Keep the
# password in a password manager -- see docs/rebuild.md.

# Addresses of every managed host. Keys must match the host names in
# inventories/dev/hosts.yaml and inventories/shared/hosts.yaml exactly;
# the inventory looks each one up as host_ips['<name>'].
host_ips:
  master-01: 10.0.0.101
  worker-01: 10.0.0.201
  worker-02: 10.0.0.202
  talos-w1: 10.0.0.111
  talos-w2: 10.0.0.112
  claude-code-01: 10.0.0.130
  nfs-01: 10.0.0.131
  vault-02: 10.0.0.133
  pihole: 10.0.0.140
  traefik: 10.0.0.141
  glance: 10.0.0.142
  gatus: 10.0.0.143
  orangutan: 10.0.0.144
  # The Proxmox host itself, for Traefik's proxmox.hl.mgryn.cc route and
  # Gatus's check of the UI on :8006.
  pve: 10.0.0.<N>

# Proxmox vmids, carried as a host var. Nothing reads them today -- they are
# inventory metadata for humans correlating a host with the Proxmox UI --
# but the inventory templates them, so a missing key renders empty.
proxmox_vm_ids:
  master-01: 2101
  worker-01: 2201
  worker-02: 2202
  claude-code-01: 102
  nfs-01: 103
  vault-02: 105
  pihole: 140
  traefik: 141
  glance: 142
  gatus: 143
  orangutan: 144

# The cloud-init user Terraform created on every VM. Becomes ansible_user,
# and cluster_admin_user for the kubeconfig the control_plane role writes.
user_name: ubuntu

# A PATH to the private key, not the key itself. Becomes
# ansible_private_key_file. The public half was injected at VM create time,
# so changing the pair means recreating every VM.
ssh_private_key: ~/.ssh/homelab_dev

# The API server address kubeadm advertises. Optional: group_vars derives it
# from host_ips['master-01'] when this is absent. Setting it here overrides
# that, which is what you want if the endpoint is a VIP or load balancer
# rather than the first control-plane node.
control_plane_endpoint: 10.0.0.101

# The NFS server exporting /srv/nfs/k8s. group_vars sets
# nfs_server: "{{ nfs_server_ip }}", consumed by the nfs_client role.
nfs_server_ip: 10.0.0.131

# Bcrypt hash of the ArgoCD admin password. The login is `admin`; ArgoCD's
# built-in local account cannot be renamed. Generate the hash with the argocd
# CLI (no login needed) -- ArgoCD uses Go's bcrypt, which accepts $2a$ and
# $2b$ and rejects $2y$; the CLI emits $2a$:
#
#   argocd account bcrypt --password 'thepassword'
#   python3 -c "import bcrypt;print(bcrypt.hashpw(b'thepassword',bcrypt.gensalt(10)).decode())"
#
# The plaintext password is never stored anywhere -- keep it in a password
# manager. This hash cannot live in Vault: argocd-vault-plugin runs inside
# argocd-repo-server, so ArgoCD must already be up before AVP resolves
# anything. It is a bootstrap credential, like the rest of this file.
argocd_admin_password_hash: "$2a$10$exampleexampleexampleexampleexampleexampleexampleexampleex"

# Grafana's admin password, applied by playbooks/cluster_secrets.yaml into the
# grafana-admin Secret that the Grafana Deployment reads. The login is
# `admin`. Grafana only applies this when it first creates its database, so on
# an existing instance reset it explicitly:
#   kubectl -n monitoring exec deploy/grafana -- \
#     grafana-cli admin reset-admin-password <newpassword>
grafana_admin_password: "change-me"

# Vault KV seed data, applied by ansible/roles/vault/tasks/seed.yaml when run
# with:
#   ansible-playbook -i inventories/shared -i inventories/dev playbooks/vault.yaml \
#     -e @secret.yaml --ask-vault-pass -e vault_configure=true -e vault_seed=true -e vault_token=<root>
# AVP reads these paths through <path:...> placeholders in Task 6.
#
# The Vault root token and unseal key are never stored here -- vault_token
# arrives per-run on the command line, never from secret.yaml or role
# defaults.
#
# Top-level keys are mounts (must be in vault_kv_mounts); the paths inside
# stay as the <path:...> placeholders name them. Seed writes a path only
# when its value differs from what is already in Vault.
vault_kv:
  kv-dev:
    jobboard/db:
      POSTGRES_PASSWORD: "<24 random chars>"
      DATABASE_URL: "postgresql://jobboard:<24 random chars>@postgres:5432/jobboard"
      JOBBOARD_SECRET: "<64 hex chars>"          # openssl rand -hex 32
      # The password appears twice above -- on its own and inside
      # DATABASE_URL. Rotate both together; changing one and not the other
      # makes Postgres reject the app with an auth failure that never hints
      # the two fields disagreed.
    jobboard/ghcr:
      username: "maxim-grin"
      token: "<GitHub PAT, scope read:packages only>"
      # The assembled pull-secret blob. AVP substitutes this whole value into
      # a kubernetes.io/dockerconfigjson Secret in Task 6. Generate it with:
      #   kubectl create secret docker-registry ghcr \
      #     --docker-server=ghcr.io --docker-username=maxim-grin \
      #     --docker-password='<PAT>' --dry-run=client \
      #     -o jsonpath='{.data.\.dockerconfigjson}' | base64 -d
      dockerconfigjson: '{"auths":{"ghcr.io":{"auth":"<base64 of username:PAT>"}}}'
    cert-manager/cloudflare:
      # Read by the cert-manager-issuers Application through
      # <path:kv-dev/data/cert-manager/cloudflare#API_TOKEN>, so the
      # ClusterIssuers can solve ACME DNS-01 for jobs.mgryn.cc.
      #
      # Two Cloudflare permissions on the mgryn.cc zone, not one:
      #   Zone -> DNS  -> Edit   write the _acme-challenge TXT record
      #   Zone -> Zone -> Read   look the zone up by name first
      # With DNS:Edit alone the zone lookup fails and cert-manager reports
      # something that reads like a DNS fault rather than a permissions one.
      #
      # Nothing to do with the certificate Cloudflare already serves for
      # mgryn.cc -- that one terminates at Cloudflare's edge and its key is
      # not obtainable. This token only writes a challenge record.
      API_TOKEN: "<Cloudflare API token, Zone:DNS:Edit + Zone:Zone:Read>"
    monitoring/prometheus:
      # Read by the monitoring Application through
      # <path:kv-dev/data/monitoring/prometheus#auth>; ingress-nginx asks
      # for this login at http://prometheus.mgryn.cc. Only `auth` is used
      # by the cluster. Keep the plain password here too: the bcrypt line
      # cannot be turned back into it.
      username: "prometheus"
      password: "<24 random chars>"
      auth: "<output of: printf '%s:%s' prometheus \"$(argocd account bcrypt --password '<password>')\">"
    monitoring/remote-write:
      # The plain login dev's Prometheus will send to prod's remote-write
      # receiver (sub-project 4). Its bcrypt line is
      # kv-prod/monitoring/remote-write#htpasswd below; change the two
      # together.
      username: "dev-remote-write"
      password: "<24 random chars>"
  # kv-prod is read by the prod ArgoCD through AVP placeholders of the
  # form <path:kv-prod/data/...#FIELD>. Same paths and field names as the
  # dev entries where one exists.
  kv-prod:
    cert-manager/cloudflare:
      # Read by the cert-manager-issuers Application through
      # <path:kv-prod/data/cert-manager/cloudflare#API_TOKEN>.
      # Same two Cloudflare permissions on the mgryn.cc zone as the dev
      # entry; without Zone:Read the zone lookup fails.
      #   Zone -> DNS  -> Edit
      #   Zone -> Zone -> Read
      API_TOKEN: "<Cloudflare API token, Zone:DNS:Edit + Zone:Zone:Read>"
    monitoring/grafana:
      # Read by the monitoring-secrets Application through
      # <path:kv-prod/data/monitoring/grafana#admin-user> and
      # #admin-password. Grafana seeds its admin password only when it
      # first creates its database; changing it here later does not
      # change the live login.
      admin-user: "admin"
      admin-password: "<24 random chars>"
    monitoring/alertmanager:
      # Read by the monitoring-secrets Application through
      # <path:kv-prod/data/monitoring/alertmanager#TELEGRAM_BOT_TOKEN>
      # and #TELEGRAM_CHAT_ID. The same bot and chat Gatus uses: copy
      # gatus_telegram_token and gatus_telegram_chat_id below. Rotate
      # them together with Gatus's, or one of the two stops alerting.
      TELEGRAM_BOT_TOKEN: "<bot token, same as gatus_telegram_token>"
      TELEGRAM_CHAT_ID: "<chat id, same as gatus_telegram_chat_id>"
    monitoring/pve-exporter:
      # Read by the pve-exporter Application (its Secret takes the three
      # token fields, its ServiceMonitor PVE_TARGET) through
      # <path:kv-prod/data/monitoring/pve-exporter#PVE_USER> and the
      # other fields. The user and token are created by
      # scripts/pve-bootstrap.sh as pve-exporter@pve, token name
      # pve-exporter. The token secret is shown once, when the script
      # prints it: copy it into secret.yaml then, or recreate the token.
      # The first three fields describe one Proxmox token; rotate them together.
      PVE_USER: "pve-exporter@pve"
      PVE_TOKEN_NAME: "pve-exporter"
      PVE_TOKEN_VALUE: "<token secret printed by pve-bootstrap.sh>"
      # The Proxmox host pve-exporter scrapes: the same address as
      # host_ips['pve']. A secret-store field because the address lives
      # only in the encrypted secret.yaml; the committed ServiceMonitor
      # carries <path:kv-prod/data/monitoring/pve-exporter#PVE_TARGET>.
      PVE_TARGET: "<Proxmox host address, same as host_ips['pve']>"
    monitoring/remote-write:
      # Read by the monitoring-secrets Application through
      # <path:kv-prod/data/monitoring/remote-write#htpasswd> (Secret
      # prometheus-basic-auth, the receiver Ingress's basic auth). Must
      # exist before that Secret reaches main: a missing field fails AVP
      # for the whole app. Generated from the kv-dev pair above.
      htpasswd: "<output of: printf '%s:%s' dev-remote-write \"$(argocd account bcrypt --password '<password>')\">"

# Pi-hole admin login, 12+ characters. Admin UI at
# https://pihole.hl.mgryn.cc/admin/ (or http://10.0.0.140/admin/).
# Changing it here and re-running playbooks/lan_services.yaml applies it.
pihole_admin_password: "<24 random chars>"

# Traefik's own Cloudflare token -- not cert-manager's, so each can be
# revoked alone. Same two permissions on the mgryn.cc zone:
#   Zone -> DNS  -> Edit   write the _acme-challenge TXT record
#   Zone -> Zone -> Read   look the zone up by name first
traefik_cloudflare_api_token: "<Cloudflare API token>"

# Dashboard logins at https://traefik.hl.mgryn.cc, htpasswd-format bcrypt lines:
#   printf '%s:%s\n' admin "$(argocd account bcrypt --password '<password>')"
traefik_dashboard_users:
  - "admin:$2a$10$<bcrypt>"

# Gatus alerts through a Telegram bot: @BotFather -> /newbot gives the
# token. Send the bot a message, then
#   curl -s https://api.telegram.org/bot<token>/getUpdates
# shows the chat id (message.chat.id).
gatus_telegram_token: "<bot token>"
gatus_telegram_chat_id: "<chat id>"

# Gatus's own basic auth: protects its API and gates the login form its
# own UI shows. Glance's Gatus widget (PR 6) needs the plaintext password
# too, so both halves are kept:
#   argocd account bcrypt --password '<password>'
# makes the hash.
gatus_basic_user: "<username>"
gatus_basic_password: "<password>"
gatus_basic_password_bcrypt: "<bcrypt hash>"

# LAN Orangutan's dashboard at https://lan.hl.mgryn.cc, 12+ characters.
# Without it the first visitor would be asked to create one.
orangutan_password: "<24 random chars>"

# Pi-hole application password for Glance's DNS widget, created once
# through Pi-hole's API (docs/rebuild.md step 15): the password for
# Glance, its hash for Pi-hole. Keeping the hash here lets a rebuilt
# Pi-hole accept the same password.
pihole_app_password: "<44 chars from /api/auth/app .app.password>"
pihole_app_pwhash: "$BALLOON-SHA256$v=1$s=1024,t=32$<salt>$<hash>"

# Glance's Proxmox widget: a read-only token, user glance@pve with
# PVEAuditor on /, no privilege separation (docs/rebuild.md step 15).
glance_proxmox_token_id: "glance@pve!glance"
glance_proxmox_token_secret: "<uuid printed once by pveum user token add>"
