# Managed by Ansible. Read by systemd as root; mode 0600.
# Glance substitutes ${VAR} into glance.yml as text, inside double quotes, so
# each value is escaped for a YAML double-quoted string (to_json without its
# outer quotes) and then for systemd's double-quoted EnvironmentFile syntax.
{% macro q(v) -%}
"{{ (v | to_json)[1:-1] | replace('\\', '\\\\') | replace('"', '\\"') }}"
{%- endmacro %}
GLANCE_PIHOLE_PASSWORD={{ q(pihole_app_password) }}
GLANCE_PROXMOX_TOKEN={{ q(glance_proxmox_token_id ~ '=' ~ glance_proxmox_token_secret) }}
GLANCE_GATUS_USER={{ q(gatus_basic_user) }}
GLANCE_GATUS_PASSWORD={{ q(gatus_basic_password) }}
