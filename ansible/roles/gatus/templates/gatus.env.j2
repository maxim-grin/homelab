# Managed by Ansible. Read by systemd as root; mode 0600.
GATUS_TELEGRAM_TOKEN={{ gatus_telegram_token }}
GATUS_TELEGRAM_CHAT_ID={{ gatus_telegram_chat_id }}
# security.basic wants the hash base64-encoded; the role encodes it so the
# plaintext hash never has to sit in secret.yaml a second time.
GATUS_BASIC_PASSWORD_BCRYPT_BASE64={{ gatus_basic_password_bcrypt | b64encode }}
