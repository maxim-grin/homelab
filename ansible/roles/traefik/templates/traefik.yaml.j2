# Managed by Ansible (roles/traefik). Static configuration: a change here
# restarts Traefik. Routes live in dynamic/, which it reloads on its own.
entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
    http:
      tls:
        certResolver: {{ traefik_cert_resolver }}
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
  metrics:
    address: ":8082"

certificatesResolvers:
  letsencrypt:
    acme:
      storage: /var/lib/traefik/acme.json
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "1.1.1.1:53"
          - "1.0.0.1:53"
  letsencrypt-staging:
    acme:
      caServer: https://acme-staging-v02.api.letsencrypt.org/directory
      storage: /var/lib/traefik/acme-staging.json
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "1.1.1.1:53"
          - "1.0.0.1:53"

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

api:
  dashboard: true

metrics:
  prometheus:
    entryPoint: metrics

log:
  level: INFO
