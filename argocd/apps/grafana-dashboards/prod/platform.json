         "title": "Apps total",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
         },
         "fieldConfig": {
            "defaults": {
               "thresholds": {
                  "mode": "absolute",
