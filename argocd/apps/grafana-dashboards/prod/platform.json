         "id": 15,
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
               },
               "expr": "count(max by (name) (argocd_app_info{autosync_enabled!=\"true\"})) or vector(0)"
            }
         ],
         "title": "Apps without autosync",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
         },
         "gridPos": {
            "h": 6,
            "w": 8,
            "x": 8,
            "y": 28
         },
         "id": 16,
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
               },
               "expr": "max by (name, project, dest_namespace, dest_server, sync_status, health_status) (argocd_app_info{sync_status!=\"Synced\"}) or max by (name, project, dest_namespace, dest_server, sync_status, health_status) (argocd_app_info{health_status!=\"Healthy\"})",
               "format": "table",
               "instant": true
            }
         ],
         "title": "Apps not Synced or not Healthy",
         "transformations": [
            {
               "id": "filterFieldsByName",
               "options": {
                  "include": {
                     "names": [
                        "name",
                        "project",
                        "dest_namespace",
                        "dest_server",
                        "sync_status",
                        "health_status"
