               "expr": "histogram_quantile(0.95, sum by (le) (rate(nginx_ingress_controller_request_duration_seconds_bucket{cluster=\"prod\", host=\"$host\"}[5m])))",
               "legendFormat": "p95"
            }
         ],
         "title": "p95 latency (prod)",
