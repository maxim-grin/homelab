               "expr": "kube_job_status_completion_time{cluster=\"$env\", namespace=\"jobboard\", job_name=~\"jobboard-crawl-.*\"} - kube_job_status_start_time{cluster=\"$env\", namespace=\"jobboard\", job_name=~\"jobboard-crawl-.*\"}",
               "legendFormat": "{{job_name}}"
            }
         ],
         "title": "Crawl duration (after first run)",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
