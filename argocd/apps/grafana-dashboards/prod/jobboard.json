               "legendFormat": "{{status}}"
            }
         ],
         "title": "Requests per second (prod)",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
         },
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "fillOpacity": 10
               },
               "unit": "percentunit"
