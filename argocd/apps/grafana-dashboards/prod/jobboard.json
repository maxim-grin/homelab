         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
               },
               "expr": "sum(rate(nginx_ingress_controller_requests{cluster=\"prod\", host=\"$host\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(nginx_ingress_controller_requests{cluster=\"prod\", host=\"$host\"}[5m])), 1e-9)",
