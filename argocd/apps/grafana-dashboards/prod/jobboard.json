{
   "description": "Jobboard pods, database volume, the jobboard-crawl CronJob, ingress and container use. Ingress panels are prod-only. Dev has no CronJob manifest, so the CronJob panels (suspend, active, next run, last success, duration) show No data for env=dev.",
   "editable": false,
   "links": [
      {
         "asDropdown": true,
         "includeVars": true,
         "tags": [
            "homelab"
         ],
         "title": "Homelab dashboards",
         "type": "dashboards"
      }
   ],
   "panels": [
      {
         "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
         },
         "fieldConfig": {
            "defaults": {
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "red",
                        "value": 1
                     }
                  ]
               },
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 6,
            "w": 8,
            "x": 0,
            "y": 0
         },
         "id": 1,
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
               },
               "expr": "sum(kube_pod_status_ready{cluster=\"$env\", namespace=\"jobboard\", condition=\"false\"}) or vector(0)"
            }
         ],
         "title": "Pods not ready",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
         },
         "fieldConfig": {
            "defaults": {
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "orange",
                        "value": 1
                     }
                  ]
               },
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 6,
            "w": 8,
            "x": 8,
            "y": 0
         },
         "id": 2,
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
               },
               "expr": "sum(increase(kube_pod_container_status_restarts_total{cluster=\"$env\", namespace=\"jobboard\"}[1h])) or vector(0)"
            }
         ],
         "title": "Container restarts, 1h",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
         },
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "fillOpacity": 10
               },
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 6,
            "w": 8,
            "x": 16,
            "y": 0
         },
         "id": 3,
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
               },
               "expr": "increase(kube_pod_container_status_restarts_total{cluster=\"$env\", namespace=\"jobboard\"}[5m])",
               "legendFormat": "{{pod}}"
            }
         ],
         "title": "Pod restarts by pod",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
         },
         "fieldConfig": {
            "defaults": {
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "green",
                        "value": null
                     },
                     {
                        "color": "orange",
                        "value": 0.69999999999999996
                     },
                     {
                        "color": "red",
                        "value": 0.80000000000000004
                     }
                  ]
               },
               "unit": "percentunit"
            }
         },
         "gridPos": {
            "h": 6,
            "w": 8,
            "x": 0,
            "y": 6
         },
         "id": 4,
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
               },
               "expr": "max(kubelet_volume_stats_used_bytes{cluster=\"$env\", namespace=\"jobboard\", persistentvolumeclaim=\"data-postgres-0\"} / kubelet_volume_stats_capacity_bytes{cluster=\"$env\", namespace=\"jobboard\", persistentvolumeclaim=\"data-postgres-0\"})"
            }
         ],
         "title": "Database volume use",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
         },
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "fillOpacity": 10
               },
               "unit": "percentunit"
            }
         },
         "gridPos": {
            "h": 6,
            "w": 8,
            "x": 8,
            "y": 6
         },
         "id": 5,
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
               },
               "expr": "kubelet_volume_stats_used_bytes{cluster=\"$env\", namespace=\"jobboard\"} / kubelet_volume_stats_capacity_bytes{cluster=\"$env\", namespace=\"jobboard\"}",
               "legendFormat": "{{persistentvolumeclaim}}"
            }
         ],
         "title": "Volume use by claim",
         "type": "timeseries"
      },
