# Copy to secret.yaml, fill in, and apply by hand:
#   kubectl apply -f argocd/apps/jobboard/base/secret.yaml
# secret.yaml is gitignored. This repository is public and ArgoCD reads it,
# so a credential committed here would be published. There is no
# argocd-vault-plugin: it was removed on 2026-09-08 after mounting a
# ConfigMap nothing created and wedging argocd-repo-server for 5h44m.
apiVersion: v1
kind: Secret
metadata:
  name: jobboard-secrets
  namespace: jobboard
type: Opaque
stringData:
  POSTGRES_PASSWORD: "<password>"
  DATABASE_URL: "postgresql://jobboard:<password>@postgres:5432/jobboard"
  # Signs session cookies. openssl rand -hex 32
  JOBBOARD_SECRET: "<hex>"
